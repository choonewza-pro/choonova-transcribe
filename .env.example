# ============ Service ============
HOST=0.0.0.0
PORT=8830
GATEWAY_API_KEY=change-me-in-production
MODEL_PATH=model/typhoon-asr-realtime.nemo
LOG_LEVEL=info

# ============ Storage ============
# Directory for the SQLite choonova-transcribe.db (default: <project>/data)
DATA_DIR=./data
# Directory for temporary long-form job files (default: /tmp/choonova-transcribe-jobs)
TEMP_JOBS_DIR=/tmp/choonova-transcribe-jobs

# ============ Hardware ============
# cuda (auto-falls back to cpu if unavailable) | cpu
DEVICE=cuda

# ============ Operational Limits ============
# Minimum free disk space required for long-form jobs (GB)
MIN_FREE_DISK_GB=5.0
# Retention window for cleanup of old jobs (hours)
TRANSCRIBE_RETENTION_HOURS=24
# Max upload size for long-form media jobs (MB); 0 = unlimited
MAX_UPLOAD_SIZE_MB=10,240
# Max upload size for short audio endpoint (MB); always enforced, must be > 0
MAX_AUDIO_UPLOAD_SIZE_MB=50.0
# Max duration in seconds for uploaded media to prevent GPU hogging (0 = unlimited, default 14400 = 4 hours)
MAX_MEDIA_DURATION_SEC=14400.0

# ============ Chunking (silence-based split) ============
# Target / max seconds per chunk (can be overridden per-request via API form)
TARGET_CHUNK_DURATION_SEC=30.0
MAX_CHUNK_DURATION_SEC=60.0

# ============ Video Compressor (FFmpeg) ============
# Encoder: libx264 (software, portable) | nvenc (GPU NVENC, needs ffmpeg with h264_nvenc)
# ถ้าเลือก nvenc แต่ runtime โหลด library/เปิด encoder ไม่ได้ → ระบบ fallback เป็น libx264 อัตโนมัติ
# หมายเหตุ Docker: ต้องตั้ง NVIDIA_DRIVER_CAPABILITIES=video,compute,utility ใน docker-compose ถึงจะ inject libnvidia-encode.so.1
COMPRESS_ENCODER=libx264
# Default x264 preset (ultrafast..veryslow) / quality (CRF 18-32, higher = smaller)
COMPRESS_PRESET=medium
COMPRESS_CRF=28
# Max videos compressed at once (1 = strict single-file queue)
COMPRESS_MAX_CONCURRENT=1
# Max jobs allowed in queue before new uploads are rejected (429)
COMPRESS_MAX_QUEUED=10
# Retention for compressed output files on disk (hours); DB record always kept
COMPRESS_RETENTION_HOURS=24

# ============ Whisper secondary engine (en / auto) ============
WHISPER_MODEL=medium

# ============ Model VRAM Residency Mode ============
# always = model stays loaded in VRAM (warm, original behavior)
# idle   = model unloaded after MODEL_IDLE_TIMEOUT_SEC of inactivity (freed VRAM)
# NOTE: This value is used ONLY to seed the settings table on first boot. After
# that the SQLite DB is the source of truth — change it at runtime from the
# dashboard homepage or via PUT /v1/settings/model (no restart needed).
MODEL_LOAD_MODE=idle
# Seconds of inactivity before unloading models in 'idle' mode
MODEL_IDLE_TIMEOUT_SEC=600

# ============ CUDA Recovery / Stability ============
# Retries with backoff for transient CUDA driver errors
CUDA_RETRY_ATTEMPTS=3
CUDA_RETRY_BACKOFF_SEC=5
# Full CUDA device reset on allocator-corruption errors
CUDA_RESET_ON_ALLOCATOR_ERROR=false
# Reset CUDA context + reload model between chunks (prevents allocator corruption)
CUDA_RESET_BETWEEN_CHUNKS=true
# Delete job files on disk when watchdog detects a crashed worker (default false)
WATCHDOG_DELETE_ON_CRASH=false

# ============ PyTorch CUDA Allocator (set by code if absent) ============
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
