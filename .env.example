# =============================================================================
# 1. Service & Security (การตั้งค่าบริการและสิทธิ์การใช้งาน)
# =============================================================================
HOST=0.0.0.0
PORT=8830
LOG_LEVEL=info
GATEWAY_API_KEY=change-me-in-production

# Public share / History dashboard permissions (WARNING: true = bypass API Key check)
ALLOW_ACCESS_TRANSCRIBE_HISTORY=false
ALLOW_ACCESS_COMPRESS_HISTORY=false


# =============================================================================
# 2. Storage & Directory Paths (ไดเรกทอรีจัดเก็บข้อมูล)
# =============================================================================
# Directory for SQLite database (choonova-transcribe.db)
DATA_DIR=./data

# Directory for temporary media & job files
TEMP_JOBS_DIR=/tmp/choonova-transcribe-jobs

# Minimum free disk space required before accepting new long-form jobs (GB)
MIN_FREE_DISK_GB=5.0


# =============================================================================
# 3. Hardware & CUDA Resilience (การตั้งค่า GPU/CUDA และความเสถียร)
# =============================================================================
# Target device: cuda (auto-falls back to cpu if unavailable) | cpu
DEVICE=cuda

# PyTorch CUDA memory allocator optimization
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# CUDA transient error retries & backoff
CUDA_RETRY_ATTEMPTS=3
CUDA_RETRY_BACKOFF_SEC=5

# CUDA error handling & context resets
CUDA_RESET_ON_ALLOCATOR_ERROR=false
CUDA_RESET_BETWEEN_CHUNKS=true

# Cleanup job files on disk when worker process crashes
WATCHDOG_DELETE_ON_CRASH=false


# =============================================================================
# 4. ASR Models & VRAM Management (โมเดลถอดความและการจัดสรร VRAM)
# =============================================================================
# Path to Typhoon ASR Realtime model (.nemo)
MODEL_PATH=model/typhoon-asr-realtime.nemo

# Faster-Whisper model size for English / Auto-detect (large-v3-turbo, medium, etc.)
WHISPER_MODEL=large-v3-turbo

# Optional Hugging Face Hub token to accept pyannote gated models
HF_TOKEN=

# Speaker Diarization settings (PyAnnote 3.1 & WhisperX)
DIARIZATION_ENABLED=true
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
DIARIZATION_MIN_SPEAKERS=
DIARIZATION_MAX_SPEAKERS=

# Model VRAM load mode: always (stay warm) | idle (auto-unload after inactivity)
# (Note: Used ONLY to seed DB on first boot; thereafter managed via DB / Dashboard)
MODEL_LOAD_MODE=idle
MODEL_IDLE_TIMEOUT_SEC=600


# =============================================================================
# 5. Transcription Pipeline & Queue Limits (คิวงานถอดความและการซอย Chunk)
# =============================================================================
# Max concurrent transcription jobs running at once (1 = single GPU job queue)
TRANSCRIBE_MAX_CONCURRENT=1

# Max jobs allowed waiting in transcription queue before rejecting (HTTP 429)
TRANSCRIBE_MAX_QUEUED=10

# Retention window for cleaning up on-disk transcription media files (hours)
TRANSCRIBE_RETENTION_HOURS=24

# Silence-based chunking limits for Typhoon ASR (Thai)
TRANSCRIBE_TYPHOON_TARGET_CHUNK_DURATION_SEC=45.0
TRANSCRIBE_TYPHOON_MAX_CHUNK_DURATION_SEC=90.0

# Silence-based chunking limits for Whisper (English / Auto)
TRANSCRIBE_WHISPER_TARGET_CHUNK_DURATION_SEC=25.0
TRANSCRIBE_WHISPER_MAX_CHUNK_DURATION_SEC=30.0


# =============================================================================
# 6. Video Compressor & Queue Limits (บีบอัดวิดีโอ FFmpeg)
# =============================================================================
# Video encoder: libx264 (software) | nvenc (GPU NVENC, fallback to libx264 if unavailable)
COMPRESS_ENCODER=libx264

# Default x264 preset (ultrafast..veryslow) & CRF quality (18-32, higher = smaller)
COMPRESS_PRESET=medium
COMPRESS_CRF=28

# Max concurrent video compression jobs running at once
COMPRESS_MAX_CONCURRENT=1

# Max jobs allowed waiting in compression queue before rejecting (HTTP 429)
COMPRESS_MAX_QUEUED=10

# Retention window for compressed output files on disk (hours)
COMPRESS_RETENTION_HOURS=24


# =============================================================================
# 7. Upload Guardrails & Media Limits (ข้อจำกัดขนาดและระยะเวลาไฟล์อัปโหลด)
# =============================================================================
# Max upload size for long-form async jobs in MB (0 = unlimited)
MAX_UPLOAD_SIZE_MB=10240.0

# Max upload size for short audio synchronous endpoint in MB (must be > 0)
MAX_AUDIO_UPLOAD_SIZE_MB=50.0

# Max media duration in seconds to prevent GPU hogging (0 = unlimited, 21600 = 6 hours)
MAX_MEDIA_DURATION_SEC=21600.0


# =============================================================================
# 8. API Endpoint Self-Test (/v1/tests/* — หน้าทดสอบ API อัตโนมัติ)
# =============================================================================
# Max wall-clock seconds waiting for an async transcription job before the
# self-test is marked FAILED (cleanup delete still runs)
APITEST_TRANSCRIBE_MAX_WAIT_SEC=1800

# Max wall-clock seconds waiting for an async compression job (CPU encode of
# a 14MB clip can take a few minutes in Docker CPU) before FAILED
APITEST_COMPRESS_MAX_WAIT_SEC=3600

# How often (seconds) the self-test polls the job status endpoint
APITEST_POLL_INTERVAL_SEC=5
